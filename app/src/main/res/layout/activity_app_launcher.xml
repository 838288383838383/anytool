<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <EditText android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Search apps..." android:singleLine="true" android:textSize="15sp" android:paddingHorizontal="16dp" android:layout_margin="12dp" android:background="@drawable/badge_background" />
    <GridLayout android:id="@+id/appGrid" android:layout_width="match_parent" android:layout_height="match_parent" android:columnCount="4" android:padding="8dp" android:useDefaultMargins="true" />
</LinearLayout>
